# ═══════════════════════════════════════════════════════════════
# CartVerse Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values
# NEVER commit the .env file - it contains secrets!

# ───────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string from Supabase
# Format: postgresql://user:password@host:port/database?schema=public
# Get this from: Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://postgres:Ashunila@2005@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?schema=public"

# For serverless/connection pooling (recommended for Render/Railway):
# DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_ID.supabase.co:6543/postgres?schema=public&pgbouncer=true"

# ───────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────

# Node environment: development | production | staging
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# ───────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ───────────────────────────────────────────────────────────────

# JWT Secret for signing tokens (generate a strong random string)
# Use a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-generate-a-strong-random-string"

# ───────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ───────────────────────────────────────────────────────────────

# Frontend URL for CORS (comma-separated if multiple)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000

# ───────────────────────────────────────────────────────────────
# FLIPKART AFFILIATE INTEGRATION (Optional)
# ───────────────────────────────────────────────────────────────

# Flipkart affiliate program credentials
FLIPKART_AFFILIATE_ID=your_affiliate_id
FLIPKART_AFFILIATE_TOKEN=your_affiliate_token
FLIPKART_API_BASE_URL=https://affiliate-api.flipkart.net/affiliate/1.0

# ═══════════════════════════════════════════════════════════════
# DEPLOYMENT PLATFORMS GUIDE
# ═══════════════════════════════════════════════════════════════

# For Render.com:
#   DATABASE_URL will be provided automatically
#   Set NODE_ENV=production
#   PORT will be auto-assigned (usually 10000)

# For Railway.app:
#   DATABASE_URL will be provided automatically
#   PORT will be auto-assigned

# For Vercel (Node.js Runtime):
#   Set environment variables in Vercel Dashboard
#   DATABASE_URL must be set
#   NODE_ENV=production

# ═══════════════════════════════════════════════════════════════
