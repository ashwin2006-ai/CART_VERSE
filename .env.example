# ═══════════════════════════════════════════════════════════════
# CartVerse Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in actual values
# NEVER commit the .env file - it contains secrets!

# ───────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# ───────────────────────────────────────────────────────────────

# PostgreSQL connection string from Supabase
# Format: postgresql://user:password@host:port/database?schema=public
# Get this from: Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?schema=public"

# Direct connection (for migrations and seeding)
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?schema=public"

# ───────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ───────────────────────────────────────────────────────────────

# Node environment: development | production | staging
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# ───────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ───────────────────────────────────────────────────────────────

# JWT Secret for signing tokens (generate a strong random string)
# Use a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-generate-a-strong-random-string"

# ───────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ───────────────────────────────────────────────────────────────

# Frontend URL for CORS (comma-separated if multiple)
# Development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000
