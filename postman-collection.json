    "version": "2.1.0",
    "_postman_id": "cartverse-collection"
  },
  "variable": [
    {
      "key": "API_URL",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Base URL for the API"
    },
    {
      "key": "API_BASE",
      "value": "http://localhost:5000/api",
      "type": "string",
      "description": "API base path"
    },
    {
      "key": "AUTH_TOKEN",
      "value": "",
      "type": "string",
      "description": "JWT token for customer authentication"
    },
    {
      "key": "ADMIN_TOKEN",
      "value": "",
      "type": "string",
      "description": "JWT token for admin authentication"
    },
    {
      "key": "USER_ID",
      "value": "",
      "type": "string",
      "description": "User ID from login response"
    },
    {
      "key": "PRODUCT_ID",
      "value": "",
      "type": "string",
      "description": "Product ID for testing"
    },
    {
      "key": "ORDER_ID",
      "value": "",
      "type": "string",
      "description": "Order ID from order creation"
    }
  ],
  "item": [
    {
      "name": "🏥 System Health & Status",
      "description": "API health checks and system status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_URL}}/api/health",
              "host": ["{{API_URL}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.have.property('status');",
                  "  pm.expect(jsonData).to.have.property('service');",
                  "  pm.expect(jsonData).to.have.property('version');",
                  "  pm.expect(jsonData.status).to.equal('healthy');",
                  "});",
                  "",
                  "pm.test('Response time is acceptable', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔐 Authentication",
      "description": "User registration and login endpoints",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser-{{$timestamp}}@example.com\",\n  \"password\": \"TestPassword123!\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{API_BASE}}/auth/register",
              "host": ["{{API_BASE}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test('Response has user data and token', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.have.property('user');",
                  "  pm.expect(jsonData).to.have.property('token');",
                  "  pm.expect(jsonData.user).to.have.property('id');",
                  "  pm.expect(jsonData.user).to.have.property('email');",
                  "});",
                  "",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const jsonData = pm.response.json();",
                  "  pm.collectionVariables.set('AUTH_TOKEN', jsonData.token);",
                  "  pm.collectionVariables.set('USER_ID', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
